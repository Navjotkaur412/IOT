A car having four wheels (DC Motors) using motor-driven IC and interface with Arduino. It will follow certain conditions
a)All the wheels moving in the backward direction for 5 secs
b)All the wheels moving in the forward direction for 5 secs
one wheels will be moving in clockwise and the rest three will move in anti-clockwise direction

Code:

int en[] = {5, 6, 9, 11};
int in1[] = {2, 4, 8, 12};
int in2[] = {3, 7, 10, 13};

void setup() {
  for (int i = 0; i < 4; i++) {
    pinMode(en[i], OUTPUT);
    pinMode(in1[i], OUTPUT);
    pinMode(in2[i], OUTPUT);
  }
}

void loop() {
  // a) All wheels backward for 5 seconds
  for (int i = 0; i < 4; i++) {
    digitalWrite(in1[i], LOW);
    digitalWrite(in2[i], HIGH);
    analogWrite(en[i], 255);
  }
  delay(5000);

  // b) All wheels forward for 5 seconds
  for (int i = 0; i < 4; i++) {
    digitalWrite(in1[i], HIGH);
    digitalWrite(in2[i], LOW);
    analogWrite(en[i], 255);
  }
  delay(5000);

  // c) One wheel clockwise, three anticlockwise
  digitalWrite(in1[0], HIGH);
  digitalWrite(in2[0], LOW);

  for (int i = 1; i < 4; i++) {
    digitalWrite(in1[i], LOW);
    digitalWrite(in2[i], HIGH);
  }

  for (int i = 0; i < 4; i++) {
    analogWrite(en[i], 255);
  }
  delay(5000);

  // Stop all motors
  for (int i = 0; i < 4; i++) {
    analogWrite(en[i], 0);
  }
  delay(1000);
}

