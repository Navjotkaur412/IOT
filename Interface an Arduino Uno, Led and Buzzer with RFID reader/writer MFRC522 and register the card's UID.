#include <SPI.h>
#include <MFRC522.h>
#define SS_PIN 10
#define RST_PIN 9
#define LED_PIN 7
#define BUZZER_PIN 6
MFRC522 rfid(SS_PIN, RST_PIN);
// CHANGE THIS TO YOUR CARD UID
byte authorizedUID[] = {0xF9, 0x3A, 0xCA, 0x79};
void setup() {
  Serial.begin(9600);
  SPI.begin();
  rfid.PCD_Init();
  pinMode(LED_PIN, OUTPUT);
  pinMode(BUZZER_PIN, OUTPUT);
  digitalWrite(LED_PIN, LOW);
  Serial.println("RFID System Ready");
  Serial.println("Scan your card...");
}
void loop() {
  // Check for a new card
  if (!rfid.PICC_IsNewCardPresent()) {
    return;
  }
  // Read card
  if (!rfid.PICC_ReadCardSerial()) {
    return;
  }
  Serial.print("Card UID: ");
  for (byte i = 0; i < rfid.uid.size; i++) {
    Serial.print(rfid.uid.uidByte[i], HEX);
    Serial.print(" ");
  }
  Serial.println();
  // Check whether card is authorized
  bool authorized = true;
  if (rfid.uid.size != sizeof(authorizedUID)) {
    authorized = false;
  }
  else {
    for (byte i = 0; i < rfid.uid.size; i++) {
      if (rfid.uid.uidByte[i] != authorizedUID[i]) {
        authorized = false;
        break;
      }
    }
  }
  // Authorized card
  if (authorized) {
    Serial.println("ACCESS GRANTED");
    digitalWrite(LED_PIN, HIGH);
    tone(BUZZER_PIN, 1000);
    delay(300);
    noTone(BUZZER_PIN);
    delay(2000);
    digitalWrite(LED_PIN, LOW);
  }
  // Unauthorized card
  else {
    Serial.println("ACCESS DENIED");
    for (int i = 0; i < 3; i++) {
      digitalWrite(LED_PIN, HIGH);
      tone(BUZZER_PIN, 300);
      delay(200);
      digitalWrite(LED_PIN, LOW);
      noTone(BUZZER_PIN);
      delay(200);
    }
  }
  rfid.PICC_HaltA();
  rfid.PCD_StopCrypto1();
  delay(1000);
}
